*{
margin:0;
padding:0;
box-sizing:border-box;
}

html,
body{
height:100%;
background:#050607;
color:#ddd;
font-family:Segoe UI,Arial,sans-serif;
overflow:hidden;
}

body{
position:relative;
}

body:before{
content:"";
position:fixed;
inset:0;
pointer-events:none;
opacity:.06;
background-image:
radial-gradient(circle at 20% 20%,#cfa95d 1px,transparent 1px),
radial-gradient(circle at 80% 30%,#cfa95d 1px,transparent 1px),
radial-gradient(circle at 40% 80%,#cfa95d 1px,transparent 1px);
background-size:130px 130px;
z-index:0;
}

/* side */

.side-panel{
position:fixed;
left:0;
top:0;
bottom:0;
width:285px;
z-index:5;
background:#070909;
border-right:2px solid #7f5a18;
box-shadow:10px 0 40px rgba(0,0,0,.55);
display:grid;
grid-template-rows:1fr auto auto auto;
gap:10px;
padding:12px;
}

.anubis-photo{
border:2px solid #7f5a18;
border-radius:18px;
background:
linear-gradient(rgba(0,0,0,.12),rgba(0,0,0,.55)),
url("/static/anubis_panel.png") center center no-repeat;
background-size:cover;
min-height:260px;
box-shadow:inset 0 0 30px rgba(0,0,0,.45);
}

.stats-box{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:8px;
}

.stat-line{
background:#111719;
border:1px solid #76551d;
border-radius:12px;
padding:9px 10px;
font-size:18px;
font-weight:800;
color:#ffd45a;
display:flex;
align-items:center;
justify-content:space-between;
min-height:42px;
}

.stat-line b{
font-size:22px;
color:#fff0bd;
}

.side-links{
display:grid;
grid-template-columns:1fr;
gap:7px;
}

.side-links a{
display:block;
padding:9px 10px;
border-radius:10px;
background:#111719;
border:1px solid #76551d;
color:#ffd45a;
text-decoration:none;
font-weight:800;
font-size:15px;
}

.hotkeys{
font-size:12px;
line-height:1.45;
color:#c7a65e;
opacity:.9;
padding:8px;
border-top:1px solid rgba(157,111,36,.45);
}

/* layout */

.layout{
position:relative;
z-index:2;
height:100vh;
margin-left:285px;
padding:12px;
display:grid;
grid-template-rows:1fr 104px;
gap:10px;
}

.fridges{
height:100%;
display:grid;
grid-template-columns:repeat(3,1fr);
gap:12px;
min-height:0;
}

.fridge{
height:100%;
min-height:0;
background:#0d1113;
border:2px solid #7b5a1e;
border-radius:18px;
padding:10px;
box-shadow:
0 0 20px rgba(0,0,0,.4),
inset 0 0 20px rgba(255,212,90,.04);
display:flex;
flex-direction:column;
}

.fridge-title{
text-align:center;
font-size:21px;
font-weight:900;
color:#ffd45a;
margin-bottom:8px;
height:28px;
line-height:28px;
}

.shelves{
height:100%;
display:grid;
grid-template-rows:repeat(5,1fr);
gap:7px;
min-height:0;
}

/* shelves */

.shelf{
border-radius:13px;
padding:7px;
cursor:pointer;
transition:.12s;
border:2px solid #444;
background:#15191b;
min-height:0;
overflow:hidden;
display:grid;
grid-template-rows:auto 1fr;
}

.shelf:hover{
filter:brightness(1.08);
}

.shelf-header{
font-weight:900;
font-size:14px;
margin-bottom:4px;
line-height:1;
color:#f0d99a;
}

.empty{
border-color:#374151;
}

.nevskryt{
border-color:#dc2626;
background:rgba(100,0,0,.18);
}

.vskryt{
border-color:#22c55e;
background:rgba(0,90,0,.16);
}

.mixed{
border-color:#d7a234;
background:rgba(90,60,0,.14);
}

.empty-text{
opacity:.45;
font-size:13px;
padding-top:8px;
}

/* bodies */

.bodies{
height:100%;
display:grid;
grid-template-columns:repeat(2,minmax(0,1fr));
gap:6px;
min-height:0;
}

.body-chip{
background:#1d2327;
border:2px solid #55606a;
border-radius:10px;
padding:6px 8px;
cursor:pointer;
transition:.12s;
font-size:13px;
min-width:0;
overflow:hidden;
display:flex;
flex-direction:column;
justify-content:center;
}

.body-chip:hover{
filter:brightness(1.12);
}

.status-1{
border-left:5px solid #dc2626;
}

.status-2{
border-left:5px solid #22c55e;
}

.body-main{
display:flex;
justify-content:space-between;
align-items:center;
gap:6px;
min-width:0;
}

.body-name{
font-weight:800;
font-size:13px;
line-height:1.15;
white-space:nowrap;
overflow:hidden;
text-overflow:ellipsis;
min-width:0;
}

.body-height{
font-weight:700;
font-size:12px;
opacity:.82;
white-space:nowrap;
}

.body-meta{
margin-top:3px;
font-size:10px;
opacity:.66;
white-space:nowrap;
overflow:hidden;
text-overflow:ellipsis;
}

/* unknown */

.unknown-zone{
height:104px;
background:#121518;
border:2px solid #9d6f24;
border-radius:18px;
padding:10px;
overflow:hidden;
cursor:pointer;
}

.unknown-title{
font-size:18px;
font-weight:900;
color:#ffd45a;
margin-bottom:7px;
line-height:1;
}

.unknown-bodies{
height:60px;
display:grid;
grid-template-columns:repeat(6,minmax(0,1fr));
gap:8px;
overflow:hidden;
}

.unknown-chip{
height:60px;
}

/* navigation */

.selected-nav{
outline:3px solid #7dd3fc;
outline-offset:2px;
box-shadow:
0 0 12px #7dd3fc,
0 0 22px rgba(125,211,252,.32);
}

.carrying{
outline:3px solid #ffcc4d;
box-shadow:0 0 14px #ffcc4d;
}

/* indicators */

.bell{
display:inline-block;
margin-left:4px;
animation:bellBlink 1s infinite;
}

@keyframes bellBlink{
50%{
opacity:.2;
transform:scale(1.2);
}
}

.warn{
display:inline-block;
color:#ffd45a;
font-weight:900;
margin-left:4px;
animation:warnBlink .75s infinite;
}

@keyframes warnBlink{
0%{
opacity:1;
transform:scale(1);
filter:drop-shadow(0 0 2px #ffd45a);
}

50%{
opacity:.2;
transform:scale(1.28);
filter:drop-shadow(0 0 8px #ffd45a);
}

100%{
opacity:1;
transform:scale(1);
}
}

.poop{
margin-left:5px;
animation:bellBlink 1.5s infinite;
}

/* voice */

#voiceStatus{
display:none;
position:fixed;
top:14px;
right:14px;
z-index:999;
padding:12px 18px;
border-radius:13px;
font-weight:800;
box-shadow:0 0 16px rgba(0,0,0,.5);
}

/* modal */

.modal{
position:fixed;
inset:0;
background:rgba(0,0,0,.72);
display:flex;
justify-content:center;
align-items:center;
z-index:50;
padding:16px;
}

.hidden{
display:none!important;
}

.modal-card{
width:100%;
max-width:640px;
background:#111416;
border:3px solid #a2772d;
border-radius:22px;
padding:22px;
box-shadow:0 0 30px rgba(0,0,0,.65);
}

.modal-header{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:18px;
}

.modal-header h2{
font-size:30px;
color:#ffd45a;
}

.modal-symbol{
font-size:34px;
}

.icon-btn{
background:none;
border:none;
font-size:36px;
color:#ddd;
cursor:pointer;
}

.field{
margin-bottom:16px;
}

.field label{
display:block;
font-weight:800;
margin-bottom:6px;
color:#d5b36c;
}

.field input,
.field textarea,
.field select{
width:100%;
padding:13px;
background:#1b2124;
border:2px solid #555;
border-radius:12px;
color:white;
font-size:18px;
}

.status-buttons{
display:flex;
gap:12px;
margin-top:10px;
}

.status-buttons button{
flex:1;
padding:12px;
background:#222a2e;
border:2px solid #666;
color:#fff;
border-radius:10px;
font-weight:800;
cursor:pointer;
}

.modal-actions{
display:flex;
gap:12px;
margin-top:18px;
}

.modal-actions button{
flex:1;
padding:14px;
font-size:18px;
font-weight:900;
border:none;
border-radius:12px;
cursor:pointer;
}

.save-btn{
background:#22c55e;
color:white;
}

.danger{
background:#dc2626;
color:white;
}

.modal-actions button:not(.save-btn):not(.danger){
background:#374151;
color:white;
}

.help{
margin-top:14px;
opacity:.65;
font-size:13px;
line-height:1.5;
}

/* table/stats/faq */

.table-page{
background:#0c0f10;
overflow:auto;
}

.table-header{
padding:20px;
text-align:center;
border-bottom:2px solid #7b5a1e;
background:#111;
}

.table-header h1{
font-size:48px;
color:#e6c06c;
margin-bottom:12px;
}

.table-link{
display:inline-block;
margin:0 8px;
color:#ffd45a;
text-decoration:none;
font-weight:800;
}

.table-panel{
max-width:1400px;
margin:auto;
padding:28px;
}

.table-panel h2{
font-size:34px;
margin-bottom:18px;
color:#ffd45a;
}

.filters{
display:grid;
grid-template-columns:2fr 1fr 1fr auto;
gap:10px;
margin-bottom:18px;
}

.filters input,
.filters select,
.filters button{
padding:12px;
border-radius:10px;
border:1px solid #76551d;
background:#111719;
color:white;
font-weight:700;
}

.bodies-table{
width:100%;
border-collapse:collapse;
font-size:15px;
}

.bodies-table th,
.bodies-table td{
padding:10px;
border-bottom:1px solid rgba(255,255,255,.12);
text-align:left;
}

.bodies-table th{
color:#ffd45a;
}

/* charts */

.stats-cards{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:14px;
margin:18px 0 28px;
}

.stat-card{
background:#111719;
border:2px solid #9d6f24;
border-radius:16px;
padding:18px;
text-align:center;
}

.stat-value{
font-size:42px;
font-weight:900;
color:#ffd45a;
}

.stat-label{
font-size:16px;
color:#c7a65e;
margin-top:6px;
}

.bar-chart{
height:250px;
display:flex;
align-items:end;
gap:14px;
padding:20px;
background:#111719;
border:2px solid #76551d;
border-radius:16px;
margin:14px 0 30px;
}

.bar-item{
flex:1;
height:100%;
display:flex;
flex-direction:column;
align-items:center;
justify-content:end;
}

.bar{
width:100%;
max-width:46px;
min-height:3px;
background:linear-gradient(180deg,#ffd45a,#9d6f24);
border-radius:8px 8px 0 0;
box-shadow:0 0 14px rgba(255,212,90,.25);
}

.bar-value{
font-weight:900;
color:#ffd45a;
margin-bottom:6px;
}

.bar-label{
font-size:13px;
margin-top:8px;
color:#c7a65e;
}

.months-chart .bar{
max-width:34px;
}

/* faq */

.faq-panel{
font-size:18px;
line-height:1.5;
}

.faq-panel h2,
.faq-panel h3{
color:#ffd45a;
margin:16px 0 10px;
}

.faq-panel ul{
padding-left:24px;
}

.faq-panel pre{
background:#111719;
border:1px solid #76551d;
padding:10px;
border-radius:10px;
margin:8px 0;
}

/* mobile */

@media (max-width:1200px){

html,
body{
overflow:auto;
}

.side-panel{
position:relative;
width:auto;
height:auto;
grid-template-rows:auto auto auto auto;
}

.anubis-photo{
height:220px;
}

.layout{
margin-left:0;
height:auto;
display:block;
}

.fridges{
grid-template-columns:1fr;
}

.fridge{
margin-bottom:12px;
}

.shelves{
grid-template-rows:none;
}

.shelf{
min-height:98px;
margin-bottom:8px;
}

.unknown-zone{
height:auto;
}

.unknown-bodies{
grid-template-columns:repeat(2,1fr);
height:auto;
}

.filters{
grid-template-columns:1fr;
}
}

@media (max-width:700px){

.stats-box{
grid-template-columns:1fr;
}

.unknown-bodies{
grid-template-columns:1fr;
}

.stats-cards{
grid-template-columns:1fr;
}

.modal-actions{
flex-direction:column;
}
}

.body-chip{
touch-action:none;
user-select:none;
}

.body-chip.dragging{
opacity:.35;
}

.drag-ghost{
position:fixed;
z-index:9999;
pointer-events:none;
background:#1d2327;
border:2px solid #ffd45a;
border-left:6px solid #ffd45a;
border-radius:10px;
padding:8px 12px;
box-shadow:0 0 18px rgba(255,212,90,.55);
color:white;
font-weight:900;
max-width:220px;
}
