--- app/static/css/mobile.css	2026-04-27 13:14:24.000000000 +0000
+++ app/static/css/mobile.css	1970-01-01 00:00:00.000000000 +0000
@@ -1,154 +0,0 @@
-@media (max-width:900px){
-
-html,
-body{
-height:auto;
-min-height:100%;
-overflow:auto;
-}
-
-body{
-padding-bottom:40px;
-}
-
-.side-panel{
-position:relative;
-width:100%;
-height:auto;
-display:block;
-border-right:none;
-border-bottom:2px solid #7f5a18;
-}
-
-.anubis-photo{
-height:220px;
-min-height:220px;
-margin-bottom:10px;
-}
-
-.stats-box{
-grid-template-columns:repeat(3,1fr);
-margin-bottom:10px;
-}
-
