-margin-bottom:8px;
-}
-
-.bodies{
-grid-template-columns:repeat(2,minmax(0,1fr));
-}
-
-.unknown-zone{
-height:auto;
-min-height:120px;
-margin-bottom:30px;
-}
-
-.unknown-bodies{
-height:auto;
-grid-template-columns:repeat(2,minmax(0,1fr));
