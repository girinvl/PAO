-display:grid;
-grid-template-columns:repeat(2,1fr);
-gap:2px 10px;
-}
-
-.layout{
-margin-left:0;
-height:auto;
-min-height:0;
-display:block;
-padding:10px;
-}
-
-.fridges{
-display:block;
-height:auto;
-}
-
-.fridge{
-height:auto;
-margin-bottom:12px;
-}
-
-.shelves{
