--- app/templates/index.html	2026-04-27 13:14:24.000000000 +0000
+++ app/templates/index.html	1970-01-01 00:00:00.000000000 +0000
@@ -1,229 +0,0 @@
-<!DOCTYPE html>
-<html lang="ru">
-<head>
-<meta charset="UTF-8">
-<meta name="viewport" content="width=device-width,initial-scale=1">
-<title>Анубис</title>
-<link rel="stylesheet" href="/static/style.css">
-</head>
-<body>
-
-<div id="voiceStatus"></div>
-
-<aside class="side-panel">
-    <div class="anubis-photo"></div>
-
-    <div class="stats-box">
-        <div class="stat-line" title="Сейчас в морге">⚰️ <b>{{ total_active }}</b></div>
-        <div class="stat-line" title="Занято полок">📦 <b>{{ 15 - free_shelves }}/15</b></div>
-        <div class="stat-line" title="Свободно полок">🟩 <b>{{ free_shelves }}</b></div>
-        <div class="stat-line" title="Поступило за неделю">📅 <b>{{ week_total }}</b></div>
-        <div class="stat-line" title="Поступило за месяц">🌙 <b>{{ month_total }}</b></div>
-        <div class="stat-line" title="Поступило за год">☀️ <b>{{ year_total }}</b></div>
-    </div>
-
-    <nav class="side-links">
-        <a href="/table">📋 Таблица</a>
-        <a href="/stats">📊 Графики</a>
-        <a href="/faq">❔ FAQ</a>
-    </nav>
-
-    <div class="hotkeys">
-        ←/→ холодильники<br>
-        ↑/↓ полки и тела<br>
-        Enter открыть<br>
-        Space взять/положить<br>
-        V голосовой код<br>
-        L голосовой рост
-    </div>
-</aside>
-
-<main class="layout">
-<section class="fridges">
-
-{% for fridge in fridge_map %}
-<div class="fridge">
-<div class="fridge-title">Холодильник {{ fridge.fridge }}</div>
-
-<div class="shelves">
-{% for shelf in fridge.shelves|reverse %}
-<div
-class="shelf {{ shelf.color_class }}"
-data-nav-type="shelf"
-data-fridge="{{ fridge.fridge }}"
-data-shelf="{{ shelf.shelf }}"
-onclick="Anubis.openShelfModal({{ fridge.fridge }},{{ shelf.shelf }})"
->
-
-<div class="shelf-header">Полка {{ shelf.shelf }}</div>
-
-{% if shelf.bodies %}
-<div class="bodies">
-{% for b in shelf.bodies %}
-<div
-class="body-chip status-{{ b.autopsy }}"
-data-nav-type="body"
-data-body-id="{{ b.id }}"
-onmouseenter="Anubis.hoveredBodyId={{ b.id }}"
-onmouseleave="if(Anubis.hoveredBodyId==={{ b.id }}) Anubis.hoveredBodyId=null"
-onclick="event.stopPropagation(); Anubis.openEditModal({{ b.id }})"
->
-
-<div class="body-main">
-<span class="body-name">
-{{ b.surname }}{% if b.initials %} {{ b.initials }}{% endif %}
-{% if b.has_comment %}<span class="bell">🔔</span>{% endif %}
-{% if b.is_duplicate_surname %}<span class="warn">❗</span>{% endif %}
-{% if b.is_old %}<span class="poop">💩</span>{% endif %}
-</span>
-
-{% if b.height %}
-<span class="body-height">{{ b.height }}</span>
-{% endif %}
-</div>
-
-<div class="body-meta">
-{{ b.fridge }}{{ b.shelf }}{{ b.autopsy }}
-· {% if b.autopsy==2 %}вскрыт{% else %}не вскрыт{% endif %}
-</div>
-
-</div>
-{% endfor %}
-</div>
-{% else %}
-<div class="empty-text">Пусто</div>
-{% endif %}
-
-</div>
-{% endfor %}
-</div>
-</div>
-{% endfor %}
-
-</section>
-
-<section
-class="unknown-zone"
-data-nav-type="unknown-zone"
-data-fridge="0"
-data-shelf="0"
-onclick="Anubis.openUnknownModal()"
->
-
-<div class="unknown-title">Без места / на полу</div>
-
-<div class="unknown-bodies">
-{% if unknown_bodies %}
-{% for b in unknown_bodies %}
-<div
-class="body-chip unknown-chip status-{{ b.autopsy }}"
-data-nav-type="body"
-data-body-id="{{ b.id }}"
-onmouseenter="Anubis.hoveredBodyId={{ b.id }}"
-onmouseleave="if(Anubis.hoveredBodyId==={{ b.id }}) Anubis.hoveredBodyId=null"
-onclick="event.stopPropagation(); Anubis.openEditModal({{ b.id }})"
->
-
-<div class="body-main">
-<span class="body-name">
-{{ b.surname }}{% if b.initials %} {{ b.initials }}{% endif %}
-{% if b.has_comment %}<span class="bell">🔔</span>{% endif %}
-{% if b.is_duplicate_surname %}<span class="warn">❗</span>{% endif %}
-{% if b.is_old %}<span class="poop">💩</span>{% endif %}
-</span>
-
-{% if b.height %}
-<span class="body-height">{{ b.height }}</span>
-{% endif %}
-</div>
-
-<div class="body-meta">
-без места · {% if b.autopsy==2 %}вскрыт{% else %}не вскрыт{% endif %}
-</div>
-
-</div>
-{% endfor %}
-{% else %}
-<div class="empty-text">Нет записей без места</div>
-{% endif %}
-</div>
-
-</section>
-</main>
-
-
-<div id="modal" class="modal hidden">
-<div class="modal-card">
-
-<div class="modal-header">
-<div class="modal-symbol">☥</div>
-<h2 id="modalTitle">Тело</h2>
-<button type="button" class="icon-btn" onclick="Anubis.closeShelfModal()">×</button>
-</div>
-
-<form id="bodyForm" onsubmit="Anubis.saveBody(event)">
-<input type="hidden" id="body_id" value="0">
-<input type="hidden" id="fridge" value="1">
-<input type="hidden" id="shelf" value="1">
-
-<div class="field">
-<label>Фамилия</label>
-<input id="surname" autocomplete="off">
-</div>
-
-<div class="field">
-<label>Инициалы</label>
-<input id="initials" autocomplete="off">
-</div>
-
-<div class="field">
-<label>Рост</label>
-<input id="height" type="number" autocomplete="off">
-</div>
-
-<div class="field">
-<label>Комментарий</label>
-<textarea id="comment" rows="4"></textarea>
-</div>
-
-<div class="field">
-<label>Статус</label>
-
-<select id="autopsy">
-<option value="1">Не вскрыт</option>
-<option value="2">Вскрыт</option>
-</select>
-
-<div class="status-buttons">
-<button type="button" onclick="Anubis.setModalStatus(1)">1 · Не вскрыт</button>
-<button type="button" onclick="Anubis.setModalStatus(2)">2 · Вскрыт</button>
-</div>
-</div>
-
-<div class="modal-actions">
-<button type="submit" class="save-btn">Сохранить</button>
-<button type="button" onclick="Anubis.closeShelfModal()">Отмена</button>
-<button type="button" class="danger" onclick="Anubis.deleteBody()">Выдать</button>
-</div>
-</form>
-
-<div class="help">
-Enter — сохранить<br>
-Esc — отмена<br>
-Space — взять/положить тело
-</div>
-
-</div>
-</div>
-
-<script src="/static/js/state.js"></script>
-<script src="/static/js/navigation.js"></script>
-<script src="/static/js/modal.js"></script>
-<script src="/static/js/speech.js"></script>
-<script src="/static/js/actions.js"></script>
-<script src="/static/js/drag.js"></script>
-<script src="/static/js/hotkeys.js"></script>
-<script src="/static/js/app.js"></script>
-
-</body>
-</html>
